# Public site configuration
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=replace-with-google-verification-token

# Experimental on-device tracking is enabled by default. Set false and rebuild to hide it.
NEXT_PUBLIC_SWING_VIDEO_PREVIEW=true

# Server-only lead storage and verification
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Server-only verification email delivery
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL="Dove Golf <noreply@example.com>"

# Optional practice accounts (disabled unless all three values are configured)
# Use only a Supabase publishable key here; never a secret/service-role key.
NEXT_PUBLIC_PRACTICE_ACCOUNTS=false
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
